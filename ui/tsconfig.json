{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "static/types.ts",
    "static/check-types.ts",
    "static/state.js",
    "static/transport.js",
    "static/waveform.js",
    "static/practice.js",
    "static/assemble.js",
    "static/placements.js",
    "static/status_handoff.js"
  ]
}
